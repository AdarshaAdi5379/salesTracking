###sales-tracking

server {
    listen 80;
    server_name salestracking.edubricz.space.com;

    root /var/www/html/frontend/sales-tracking;
    index index.html;

    # static assets
    location /assets/ {
      try_files $uri =404;
      expires 1y;
      add_header Cache-Control "public, immutable";
    }

    # proxy API to your backend (so frontend can call /areas, /schools, etc.)
    location ~ ^/(areas|users|schools|routes|reports|places)(/|$) {
      proxy_pass https://pooja.edubricz.space;
      proxy_set_header Host pooja.edubricz.space;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA routing fallback
    location / {
      try_files $uri $uri/ /index.html;
    }
  }



